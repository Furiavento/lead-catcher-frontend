# ─────────────────────────────────────────────────────────────────────────────
# Lead Catcher Frontend - runtime environment variables
#
# These are read by the SSR server when the container starts, so the same
# image works in any environment. Changing them only needs a restart.
#
# IMPORTANT (Dokploy / docker --env-file): write KEY=value WITHOUT quotes and
# without spaces around "=".
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000

# Public URL of the API, including the /api prefix. The browser calls it
# directly, so it must be reachable from the user's browser (not an internal
# Docker hostname). Add this frontend's origin to CORS_ORIGINS in the backend.
API_URL=https://api.example.com/api

# Comma-separated host names this server answers to (Angular SSRF protection).
# Requests with any other Host header get a 400, so set it to the domain
# configured in Dokploy (add localhost to test the container locally).
NG_ALLOWED_HOSTS=panel.example.com

# Privacy policy linked from the public lead form (/f/<source>). The version is
# stored with each lead as evidence of what the visitor accepted.
PRIVACY_POLICY_URL=https://example.com/privacidad
PRIVACY_POLICY_VERSION=2026-01

# Comma-separated origins allowed to embed the public form in an iframe.
# Empty = any site. The admin panel can never be embedded.
FORM_FRAME_ANCESTORS=
